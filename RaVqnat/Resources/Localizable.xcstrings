    },
    "delete.explainer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting your account is permanent. You'll be signed out and won't be able to recover it."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ანგარიშის წაშლა საბოლოოა. სისტემიდან გახვალ და მისი აღდგენა შეუძლებელი იქნება."
          }
        }
      }
    },
    "delete.item.activities": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upcoming activities you host are cancelled."
          }
