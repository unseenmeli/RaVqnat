    "block.confirm.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They won't be able to see your activities, message you, or join activities with you. If you host something they joined, they'll be removed; if they host something you joined, you'll leave it. They won't be notified."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ვეღარ ნახავს შენს აქტივობებს, ვეღარ მოგწერს და ვეღარ შეუერთდება აქტივობას შენთან ერთად. თუ შენს აქტივობაშია — ამოიშლება; თუ შენ ხარ მის აქტივობაში — დატოვებ. მას არ ეცნობება."
          }
        }
      }
    },
