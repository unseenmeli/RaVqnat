            "state": "translated",
            "value": "შენი პროფილი, ფოტო და ინტერესები წაიშლება."
          }
        }
      }
    },
    "delete.item.reports": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Safety reports are kept for a limited time, as described in our privacy policy."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "უსაფრთხოების საჩივრები შეზღუდული ვადით ინახება, როგორც ეს კონფიდენციალურობის პოლიტიკაშია აღწერილი."
          }
        }
      }
    },
    "delete.type %@": {
      "localizations": {
        "en": {
